# Copia este archivo como ".env" y completa los dos valores.
# Los encuentras en tu panel de Supabase: Project Settings > API.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: cuenta demo. Si completas las dos, el inicio de sesión muestra
# "Probar la demo" y esa cuenta se llena sola con datos de ejemplo.
# (En Netlify se cargan en Site configuration > Environment variables.)
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
